# VYREX AI Backend Environment Configuration

# Server Port (Render sets $PORT automatically)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Allowed CORS Origins (comma-separated, or * for all)
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app

# Optional: Remote GPU Worker URL (e.g., Modal, RunPod, or ngrok tunnel)
# REMOTE_GPU_URL=https://your-modal-worker.modal.run

# Optional: Upstream API Key for pure serverless cloud fallback
# FALLBACK_API_KEY=gsk_your_groq_or_openrouter_api_key
# FALLBACK_API_BASE=https://api.groq.com/openai/v1
# FALLBACK_MODEL=llama-3.1-8b-instant
